# Environnements virtuels Python
env/
venv/
ENV/
env.bak/
venv.bak/

# Fichiers compilés Python
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class

# Fichiers logs et temporaires
*.log
*.tmp
*.bak
*.swp
*.swo

# Fichiers de base de données SQLite (si utilisé)
*.sqlite3
*.db


# Dossier de configuration IDEs courants
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Dossier node_modules (si tu utilises npm pour frontend)
node_modules/

# fichiers build JS (si tu utilises webpack ou autre)
dist/
build/

# Fichiers système (Mac, Windows)
.DS_Store
Thumbs.db

# Fichiers Flask debug (cache, sessions, etc)
instance/
*.pyc

# fichiers secrets (à ne pas commiter)
.env
.env.local
*.tfvars
*.tfvars.json

# Terraform local state and provider cache. The lock file stays in git.
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json


.Identifier

# Markdown and docs stay local. The project README is the exception.
*.md
!/README.md
docs/